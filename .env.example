PORT=8080

# Upstream backend to wrap.
# This can be any HTTP endpoint that accepts the envelope documented in README.md.
UPSTREAM_CHAT_URL=http://127.0.0.1:8000/chat
UPSTREAM_CHAT_METHOD=POST

# Optional upstream auth.
# For an Istio endpoint that expects ApiKey auth:
#   UPSTREAM_API_KEY=...
#   UPSTREAM_API_KEY_HEADER=Authorization
#   UPSTREAM_API_KEY_PREFIX=ApiKey
UPSTREAM_API_KEY=
UPSTREAM_API_KEY_HEADER=Authorization
UPSTREAM_API_KEY_PREFIX=ApiKey

# Optional extra headers as JSON.
UPSTREAM_EXTRA_HEADERS_JSON={}

# Shim state.
LANGGRAPH_SHIM_DB_PATH=/tmp/langgraph-shim.sqlite3
LANGGRAPH_SHIM_ASSISTANT_ID=testlanggraph
LANGGRAPH_SHIM_GRAPH_ID=testlanggraph
